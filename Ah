def agregar_evento_recorder(tipo, valor):
    if recorder_started_at is not None:
        recorder_events.append((time.perf_counter() - recorder_started_at, tipo, valor))

def grabar_tecla_recorder(evento):
    if evento.event_type not in (keyboard.KEY_DOWN, keyboard.KEY_UP) or not esta_en_roblox():
        return

    nombre_tecla = str(evento.name)
    with recorder_lock:
        if recorder_mode != "recording" or recorder_started_at is None:
            return
        if evento.event_type == keyboard.KEY_DOWN:
            if nombre_tecla in recorder_keys_down:
                return
            recorder_keys_down.add(nombre_tecla)
            agregar_evento_recorder("key_down", nombre_tecla)
        elif nombre_tecla in recorder_keys_down:
            recorder_keys_down.remove(nombre_tecla)
            agregar_evento_recorder("key_up", nombre_tecla)

