# --- FUNCIONES NATIVAS DE WINDOWS Y SISTEMA ---

def obtener_ventana_activa():
    try:
        hwnd = ctypes.windll.user32.GetForegroundWindow()
        longitud = ctypes.windll.user32.GetWindowTextLengthW(hwnd)
        buffer = ctypes.create_unicode_buffer(longitud + 1)
        ctypes.windll.user32.GetWindowTextW(hwnd, buffer, longitud + 1)
        return buffer.value
    except Exception:
        return ""

def esta_en_roblox():
    ventana_actual = obtener_ventana_activa().lower()
    return "roblox" in ventana_actual and "ggspqe" not in ventana_actual

def presionar_tecla_nativo(tecla_char):
    """Envía un par de eventos de teclado con scan codes explícitos."""
    user32 = ctypes.windll.user32
    char_key = str(tecla_char).lower()
    
    if char_key in VK_MAP:
        vk, scan_code = VK_MAP[char_key]
    else:
        vk = ord(char_key.upper())
        scan_code = user32.MapVirtualKeyW(vk, 0)

    eventos = (INPUT * 2)()
    eventos[0].type = 1
    eventos[0].ki = KEYBDINPUT(0, scan_code, 0x0008, 0, 0)
    eventos[1].type = 1
    eventos[1].ki = KEYBDINPUT(0, scan_code, 0x000A, 0, 0)

    user32.SendInput.argtypes = (wintypes.UINT, ctypes.POINTER(INPUT), ctypes.c_int)
    user32.SendInput.restype = wintypes.UINT
    enviados = user32.SendInput(2, eventos, ctypes.sizeof(INPUT))
    if enviados != 2:
        user32.keybd_event(vk, scan_code, 0, 0)
        time.sleep(0.015)
        user32.keybd_event(vk, scan_code, 0x0002, 0)

