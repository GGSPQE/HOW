def exportar_perfil():
    nombre = combo_perfiles.get().strip()
    if nombre not in perfiles_config:
        messagebox.showwarning("Perfil", "Selecciona un perfil guardado para exportar.")
        return

    ruta = filedialog.asksaveasfilename(
        title="Exportar perfil",
        defaultextension=".json",
        initialfile="perfil.json",
        filetypes=[("Archivo JSON", "*.json")]
    )
    if not ruta:
        return

    try:
        with open(ruta, "w", encoding="utf-8") as archivo:
            json.dump({
                "name": nombre,
                "config": perfiles_config[nombre],
                "color": perfil_colores.get(nombre, app_accent_color)
            }, archivo, indent=4)
        messagebox.showinfo("Perfil exportado", f"Se exportó el perfil {nombre}.")
    except OSError as error:
        messagebox.showerror("Error al exportar", str(error))

def importar_perfil():
    global perfil_activo, perfiles_config
    ruta = filedialog.askopenfilename(
        title="Importar perfil",
        filetypes=[("Archivo JSON", "*.json")]
    )
    if not ruta:
        return

    try:
        with open(ruta, "r", encoding="utf-8") as archivo:
            datos = json.load(archivo)
    except (OSError, json.JSONDecodeError) as error:
        messagebox.showerror("Error al importar", f"No se pudo leer el archivo JSON:\n{error}")
        return

    nombre = datos.get("name") if isinstance(datos, dict) else None
    config = datos.get("config") if isinstance(datos, dict) else None
    color_perfil = datos.get("color", app_accent_color) if isinstance(datos, dict) else app_accent_color
    if not isinstance(color_perfil, str):
        messagebox.showerror("Perfil no válido", "El color del perfil no es válido.")
        return
    try:
        root.winfo_rgb(color_perfil)
    except tk.TclError:
        messagebox.showerror("Perfil no válido", "El color del perfil no es válido.")
        return
    campos_texto = (
        "afk_tiempo", "afk_key", "afk_accion", "click_tiempo", "click_key",
        "click_tipo", "lag_key", "lag_duracion", "shuffle_key", "shuffle_delay",
        "fast_swap_key", "fast_swap_delay", "fast_swap_secondary_key"
    )
    campos_booleanos = ("fast_swap_hold", "slot1", "slot2", "slot3", "slot4", "beep")
    campos_auto_train_booleanos = (
        "auto_train_slot1", "auto_train_slot2", "auto_train_slot3", "auto_train_slot4",
        "auto_train_click"
    )
    campos_hotkeys_recorder = ("recorder_start_key", "recorder_play_key", "recorder_stop_key")

    if (
        not isinstance(nombre, str)
        or not nombre.strip()
        or not isinstance(config, dict)
        or any(not isinstance(config.get(campo), str) for campo in campos_texto)
        or any(not isinstance(config.get(campo), bool) for campo in campos_booleanos)
        or any(campo in config and not isinstance(config[campo], bool) for campo in campos_auto_train_booleanos)
        or "auto_train_click_type" in config and not isinstance(config["auto_train_click_type"], str)
        or "auto_train_delay" in config and not isinstance(config["auto_train_delay"], str)
        or "auto_train_key" in config and not isinstance(config["auto_train_key"], str)
        or any(campo in config and not isinstance(config[campo], str) for campo in campos_hotkeys_recorder)
    ):
        messagebox.showerror("Perfil no válido", "El archivo no contiene un perfil compatible.")
        return

    nombre = nombre.strip()
    atajos = (
        ("Anti-AFK", config["afk_key"].strip().lower()),
        ("Autoclicker", config["click_key"].strip().lower()),
        ("Lag Switch", config["lag_key"].strip().lower()),
        ("Shuffle Reload", config["shuffle_key"].strip().lower()),
        ("Fast Gun Swap", config["fast_swap_key"].strip().lower()),
        ("Auto Train", config.get("auto_train_key", "f5").strip().lower()),
        ("Recorder - Grabar", config.get("recorder_start_key", "f6").strip().lower()),
        ("Recorder - Reproducir", config.get("recorder_play_key", "f7").strip().lower()),
        ("Recorder - Detener", config.get("recorder_stop_key", "f8").strip().lower())
    )
    try:
        conflictos = encontrar_conflictos_hotkeys(atajos)
    except ValueError as error:
        messagebox.showerror("Perfil no válido", str(error))
        return
    if conflictos:
        detalle = "\n".join(" y ".join(grupo) for grupo in conflictos)
        messagebox.showerror("Perfil no válido", f"El perfil repite estos atajos:\n{detalle}")
        return

    if nombre in perfiles_config and not messagebox.askyesno(
        "Reemplazar perfil",
        f"Ya existe un perfil llamado {nombre}. ¿Quieres reemplazarlo?"
    ):
        return

    detener_todo()
    perfiles_config[nombre] = config
    perfil_colores[nombre] = color_perfil.lower()
    perfil_activo = nombre
    combo_perfiles.configure(values=sorted(perfiles_config))
    combo_perfiles.set(nombre)
    aplicar_configuracion(config)
    actualizar_muestra_color_perfil()
    actualizar_hotkeys()

def cargar_configuracion():
    global perfil_activo, perfiles_config, roblox_profile_username, app_accent_color
    global app_theme_name, app_ui_scale, perfil_colores, orden_secciones, recorder_macros
    global sonidos_activos, avisos_recorder_activos
    datos = {}
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r") as f:
                datos = json.load(f)
        except Exception:
            pass

    if isinstance(datos, dict) and isinstance(datos.get("profiles"), dict):
        perfiles_config = {
            nombre: config for nombre, config in datos["profiles"].items()
            if isinstance(nombre, str) and isinstance(config, dict)
        }
        perfil_activo = datos.get("active_profile", "Predeterminado")
        if perfil_activo not in perfiles_config:
            perfil_activo = next(iter(perfiles_config), "Predeterminado")
    else:
        perfil_activo = "Predeterminado"
        perfiles_config = {perfil_activo: datos if isinstance(datos, dict) else {}}

    var_intro_animacion.set(bool(datos.get("intro_animation", True)) if isinstance(datos, dict) else True)
    roblox_profile_username = (
        datos.get("roblox_username", "")
        if isinstance(datos, dict) and isinstance(datos.get("roblox_username", ""), str)
        else ""
    )
    color_guardado = (
        datos.get("app_accent_color", "#00ffcc")
        if isinstance(datos, dict) and isinstance(datos.get("app_accent_color", "#00ffcc"), str)
        else "#00ffcc"
    )
    try:
        root.winfo_rgb(color_guardado)
        app_accent_color = color_guardado.lower()
    except tk.TclError:
        app_accent_color = "#00ffcc"
    tema_guardado = datos.get("app_theme", "GGSPQE") if isinstance(datos, dict) else "GGSPQE"
    app_theme_name = tema_guardado if tema_guardado in APP_THEMES else "GGSPQE"
    factor_guardado = datos.get("app_ui_scale", 1.0) if isinstance(datos, dict) else 1.0
    app_ui_scale = factor_guardado if factor_guardado in (0.9, 1.0, 1.15) else 1.0
    colores_guardados = datos.get("profile_colors", {}) if isinstance(datos, dict) else {}
    perfil_colores = {}
    if isinstance(colores_guardados, dict):
        for nombre, color in colores_guardados.items():
            if isinstance(nombre, str) and isinstance(color, str):
                try:
                    root.winfo_rgb(color)
                    perfil_colores[nombre] = color.lower()
                except tk.TclError:
                    pass
    orden_guardado = datos.get("menu_order", []) if isinstance(datos, dict) else []
    secciones_validas = ("Roblox", "Juegos", "Texturas", "Recorder", "Preferencias")
    orden_secciones = [
        seccion for seccion in orden_guardado
        if isinstance(seccion, str) and seccion in secciones_validas
    ] if isinstance(orden_guardado, list) else []
    orden_secciones = list(dict.fromkeys(orden_secciones))
    orden_secciones.extend(seccion for seccion in secciones_validas if seccion not in orden_secciones)
    macros_guardados = datos.get("recorder_macros", {}) if isinstance(datos, dict) else {}
    recorder_macros = {}
    if isinstance(macros_guardados, dict):
        for nombre, eventos in macros_guardados.items():
            if isinstance(nombre, str) and nombre.strip():
                eventos_validados = validar_eventos_recorder(eventos)
                if eventos_validados:
                    recorder_macros[nombre] = eventos_validados
    sonidos_activos = bool(datos.get("app_sounds_enabled", True)) if isinstance(datos, dict) else True
    avisos_recorder_activos = bool(datos.get("recorder_notifications", True)) if isinstance(datos, dict) else True
    var_sonidos_app.set(sonidos_activos)
    var_avisos_recorder.set(avisos_recorder_activos)
    entry_roblox_username.insert(0, roblox_profile_username)

    aplicar_configuracion(perfiles_config[perfil_activo])
    combo_perfiles.configure(values=sorted(perfiles_config))
    combo_perfiles.set(perfil_activo)
    combo_tema_app.set(app_theme_name)
    combo_escala_app.set({0.9: "Compacta", 1.0: "Normal", 1.15: "Grande"}[app_ui_scale])
    color_acento_guardado = app_accent_color
    aplicar_tema_app(app_theme_name)
    if color_acento_guardado != APP_THEMES[app_theme_name]["accent"]:
        aplicar_color_app(color_acento_guardado)
    aplicar_escala_app(app_ui_scale)
    actualizar_muestra_color_perfil()
    actualizar_lista_orden_menu()
    actualizar_lista_macros()
    aplicar_orden_menu()
    if not avisos_recorder_activos:
        lbl_recorder_estado.pack_forget()

