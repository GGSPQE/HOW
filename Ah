def ajustar_botones_ventana(event=None):
    factor = min(1.5, max(1.0, root.winfo_width() / ancho_ventana))
    frame_izquierdo.config(width=round(160 * factor))
    for boton, ancho_base in botones_redimensionables:
        boton.config(width=round(ancho_base * factor))

def buscar_botones(widget):
    botones = []
    for hijo in widget.winfo_children():
        if isinstance(hijo, tk.Button):
            botones.append((hijo, int(hijo.cget("width"))))
        botones.extend(buscar_botones(hijo))
    return botones

botones_redimensionables = buscar_botones(root)
root.bind("<Configure>", ajustar_botones_ventana)
root.after_idle(ajustar_botones_ventana)

def mostrar_intro_digital():
    root.withdraw()
    intro = tk.Toplevel(root)
    intro.overrideredirect(True)
    intro.geometry(f"{ancho_ventana}x{alto_ventana}+{pos_x}+{pos_y}")

    fondo = "#080d0c"
    lienzo = tk.Canvas(intro, width=ancho_ventana, height=alto_ventana, bg=fondo, highlightthickness=0)
    lienzo.pack(fill=tk.BOTH, expand=True)

    columnas = []
    cantidad_columnas = ancho_ventana // 20
    for indice in range(cantidad_columnas):
        x = indice * 20 + 10
        y = random.randint(-alto_ventana, alto_ventana)
        velocidad = random.randint(5, 12)
        estela = random.randint(7, 13)
        elementos = [
            lienzo.create_text(x, y, text="", fill="#36ff9a", font=("Consolas", 11, "bold"))
            for _ in range(estela)
        ]
        columnas.append({"x": x, "y": y, "velocidad": velocidad, "estela": estela, "elementos": elementos})

    lienzo.create_text(
        ancho_ventana // 2 + 2,
        alto_ventana // 2 - 12 + 2,
        text="GGSPQE",
        fill="#06100b",
        font=("Consolas", 29, "bold")
    )
    lienzo.create_text(
        ancho_ventana // 2,
        alto_ventana // 2 - 12,
        text="GGSPQE",
        fill="#e5fff0",
        font=("Consolas", 29, "bold")
    )
    lienzo.create_line(
        ancho_ventana // 2 - 90,
        alto_ventana // 2 + 18,
        ancho_ventana // 2 + 90,
        alto_ventana // 2 + 18,
        fill="#24d879",
        width=2
    )
    lienzo.create_text(
        ancho_ventana // 2,
        alto_ventana // 2 + 43,
        text="ROBLOX UTILITY",
        fill="#7dcea0",
        font=("Consolas", 10)
    )

    colores_estela = ("#25d879", "#1bad61", "#13834b", "#0e633a", "#0a492d", "#083923")
    activa = True

    def animar():
        nonlocal activa
        if not activa or not intro.winfo_exists():
            return
        for columna in columnas:
            columna["y"] += columna["velocidad"]
            if columna["y"] - columna["estela"] * 18 > alto_ventana:
                columna["y"] = random.randint(-260, -40)
                columna["velocidad"] = random.randint(5, 12)
                columna["estela"] = random.randint(7, 13)
            for indice, elemento in enumerate(columna["elementos"]):
                lienzo.coords(elemento, columna["x"], columna["y"] - indice * 18)
                lienzo.itemconfig(
                    elemento,
                    text=str(random.randint(0, 9)),
                    fill="#baffd4" if indice == 0 else colores_estela[min(indice - 1, len(colores_estela) - 1)]
                )
        intro.after(55, animar)

    def terminar():
        nonlocal activa
        if not activa:
            return
        activa = False
        intro.destroy()
        root.deiconify()
        root.lift()

    boton_saltar = tk.Button(
        intro,
        text="Saltar intro",
        command=terminar,
        bg="#13251b",
        fg="#d8ffe7",
        activebackground="#1d3d2b",
        activeforeground="white",
        bd=0,
        padx=12,
        pady=5
    )
    lienzo.create_window(ancho_ventana - 78, alto_ventana - 26, window=boton_saltar)
    intro.bind("<KeyPress>", lambda evento: terminar())
    animar()
    intro.after(2400, terminar)
    intro.focus_force()

if intro_animacion_activa:
    mostrar_intro_digital()
else:
    root.deiconify()

root.mainloop()
