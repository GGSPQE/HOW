                pass

            if activar:
                rule_obj = win32com.client.Dispatch("HNetCfg.FwRule")
                rule_obj.Name = "RobloxLagSwitch"
                rule_obj.ApplicationName = ruta_roblox if ruta_roblox else ""
                rule_obj.Direction = 2  # Outbound
                rule_obj.Action = 0     # Block
                rule_obj.InterfaceTypes = "All"
                rule_obj.Enabled = True
                rules.Add(rule_obj)
            return True, ""
        except Exception:
            pass

    try:
        subprocess.run('netsh advfirewall firewall delete rule name="RobloxLagSwitch"', shell=True, capture_output=True)
        if activar:
            cmd = f'netsh advfirewall firewall add rule name="RobloxLagSwitch" dir=out action=block'
            if ruta_roblox:
                cmd += f' program="{ruta_roblox}"'
            resultado = subprocess.run(cmd, shell=True, capture_output=True, text=True)
            if resultado.returncode != 0:
                detalle = resultado.stderr.strip() or resultado.stdout.strip()
                return False, detalle or "No se pudo añadir la regla. Ejecuta la aplicación como administrador."
        return True, ""
    except Exception as error:
        return False, str(error)

