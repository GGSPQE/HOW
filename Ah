def iniciar_grabacion_recorder():
    global recorder_events, recorder_mode, recorder_started_at
    global recorder_keyboard_hook, recorder_stop, recorder_keys_down

    if recorder_mode != "idle" or (recorder_playback_stop and not recorder_playback_stop.is_set()):
        messagebox.showwarning("Recorder", "Detén la grabación o reproducción actual primero.")
        return

    with recorder_lock:
        recorder_events = []
        recorder_keys_down.clear()
        recorder_started_at = None
        recorder_mode = "waiting"
    recorder_stop = threading.Event()
    recorder_keyboard_hook = keyboard.hook(grabar_tecla_recorder, suppress=False)
    programar_ui_recorder("Pasa a Roblox para empezar a grabar...", "#ffcc00")
    threading.Thread(target=recorder_mouse_worker, daemon=True).start()

def recorder_mouse_worker():
    global recorder_mode, recorder_started_at, recorder_keyboard_hook

    user32 = ctypes.windll.user32
    botones_vinculados = {"izquierdo": 0x01, "derecho": 0x02, "central": 0x04}
    botones_pulsados = set()
    ultima_posicion = None
    punto = RECORDER_POINT()
    stop_event = recorder_stop

    while not stop_event.is_set():
        en_roblox = esta_en_roblox()
        with recorder_lock:
            if recorder_mode == "waiting" and en_roblox:
                recorder_mode = "recording"
                recorder_started_at = time.perf_counter()
                programar_ui_recorder(
                    "Grabando... vuelve a esta ventana para terminar.", "#ff5555", sonido=True
                )
            elif recorder_mode == "recording" and not en_roblox:
                break

            if recorder_mode == "recording":
                if user32.GetCursorPos(ctypes.byref(punto)):
                    posicion = (punto.x, punto.y)
                    if posicion != ultima_posicion:
                        agregar_evento_recorder("mouse_move", posicion)
                        ultima_posicion = posicion

                for nombre_boton, codigo_boton in botones_vinculados.items():
                    pulsado = bool(user32.GetAsyncKeyState(codigo_boton) & 0x8000)
                    if pulsado and nombre_boton not in botones_pulsados:
                        botones_pulsados.add(nombre_boton)
                        agregar_evento_recorder("mouse_down", nombre_boton)
                    elif not pulsado and nombre_boton in botones_pulsados:
                        botones_pulsados.remove(nombre_boton)
                        agregar_evento_recorder("mouse_up", nombre_boton)
        stop_event.wait(0.01)

    with recorder_lock:
        if recorder_started_at is not None:
            for nombre_boton in botones_pulsados:
                agregar_evento_recorder("mouse_up", nombre_boton)
            for nombre_tecla in recorder_keys_down:
                agregar_evento_recorder("key_up", nombre_tecla)
            recorder_keys_down.clear()
        recorder_started_at = None
        recorder_mode = "idle"
        eventos_totales = len(recorder_events)

    if recorder_keyboard_hook is not None:
        try:
            keyboard.unhook(recorder_keyboard_hook)
        except Exception:
            pass
        recorder_keyboard_hook = None
    if eventos_totales:
        programar_ui_recorder(
            f"Grabación lista: {eventos_totales} eventos.", "#00cc88", sonido=True
        )
    else:
        programar_ui_recorder(
            "No se grabaron eventos. Inicia con Roblox en primer plano.", "#ffcc00", sonido=True
        )

