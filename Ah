def normalizar_nombre_tecla(nombre):
    nombre = nombre.lower().replace("left ", "").replace("right ", "")
    return {"windows": "windows", "command": "windows"}.get(nombre, nombre)

def recibir_tecla_para_captura(evento):
    global captura_hotkey_activa, captura_modificador_suelto
    nombre = normalizar_nombre_tecla(evento.name)
    modificadores = {"ctrl", "shift", "alt", "windows"}

    if evento.event_type == keyboard.KEY_DOWN:
        if evento.scan_code in captura_teclas_pulsadas:
            return
        captura_teclas_pulsadas.add(evento.scan_code)
        if nombre == "esc":
            eventos_hotkey.put(("hotkey_capture_cancel",))
        elif nombre in modificadores:
            captura_modificadores.add(nombre)
            captura_modificador_suelto = nombre
        else:
            combo = "+".join(sorted(captura_modificadores) + [nombre])
            eventos_hotkey.put(("hotkey_capture_done", combo))
    else:
        captura_teclas_pulsadas.discard(evento.scan_code)
        if nombre in modificadores:
            captura_modificadores.discard(nombre)
            if captura_modificador_suelto == nombre and not captura_teclas_pulsadas:
                eventos_hotkey.put(("hotkey_capture_done", nombre))
            captura_modificador_suelto = None

def iniciar_captura_hotkey(entry, boton):
    global captura_hotkey_activa, captura_hotkey_hook
    global captura_hotkey_entry, captura_hotkey_boton, captura_timeout_id

    cancelar_captura_hotkey()
    captura_hotkey_activa = True
    captura_hotkey_entry = entry
    captura_hotkey_boton = boton
    captura_teclas_pulsadas.clear()
    captura_modificadores.clear()
    boton.config(text="Pulsa tecla...")
    captura_hotkey_hook = keyboard.hook(recibir_tecla_para_captura, suppress=False)
    captura_timeout_id = root.after(10000, cancelar_captura_hotkey)

def cancelar_captura_hotkey():
    global captura_hotkey_activa, captura_hotkey_hook, captura_hotkey_entry
    global captura_hotkey_boton, captura_timeout_id

    if captura_hotkey_hook is not None:
        keyboard.unhook(captura_hotkey_hook)
    if captura_timeout_id is not None:
        try:
            root.after_cancel(captura_timeout_id)
        except tk.TclError:
            pass
    if captura_hotkey_boton is not None:
        captura_hotkey_boton.config(text="Asignar")
    captura_hotkey_activa = False
    captura_hotkey_hook = None
    captura_hotkey_entry = None
    captura_hotkey_boton = None
    captura_timeout_id = None
    captura_teclas_pulsadas.clear()
    captura_modificadores.clear()
    captura_modificador_suelto = None

