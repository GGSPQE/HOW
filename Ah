        return ctypes.windll.shell32.IsUserAnAdmin()
    except Exception:
        return False

def obtener_ruta_roblox():
    try:
        comando = (
            "Get-CimInstance Win32_Process -Filter \"Name='RobloxPlayerBeta.exe' "
            "OR Name='WindowsUniversal.exe'\" | "
            "Select-Object -ExpandProperty ExecutablePath"
        )
        resultado = subprocess.run(
            ["powershell", "-NoProfile", "-NonInteractive", "-Command", comando],
            capture_output=True,
            text=True,
            timeout=5
        )
        if resultado.returncode == 0:
            for ruta in resultado.stdout.splitlines():
                ruta = ruta.strip()
                if ruta and os.path.isfile(ruta):
                    return ruta
    except (OSError, subprocess.SubprocessError):
        pass

    local_appdata = os.environ.get("LOCALAPPDATA", "")
    ruta_default = os.path.join(local_appdata, "Roblox", "Versions")
    if os.path.exists(ruta_default):
        for root_dir, dirs, files in os.walk(ruta_default):
            if "RobloxPlayerBeta.exe" in files:
                return os.path.join(root_dir, "RobloxPlayerBeta.exe")
    return ""

def obtener_carpeta_texturas_roblox():
    exe_roblox = obtener_ruta_roblox()
    if exe_roblox:
        dir_version = os.path.dirname(exe_roblox)
        dir_texturas = os.path.join(dir_version, "PlatformContent", "pc", "textures")
        if os.path.exists(dir_texturas):
            return dir_texturas
    return ""

def consultar_perfil_roblox(nombre_usuario):
    def worker():
        try:
            solicitud_usuario = urllib.request.Request(
                "https://users.roblox.com/v1/usernames/users",
                data=json.dumps({
                    "usernames": [nombre_usuario],
                    "excludeBannedUsers": True
                }).encode("utf-8"),
                headers={
                    "Content-Type": "application/json",
                    "User-Agent": "GGSPQE-Roblox-Utility/1.0"
                },
                method="POST"
            )
            with urllib.request.urlopen(solicitud_usuario, timeout=10) as respuesta:
                resultado_usuario = json.loads(respuesta.read().decode("utf-8"))
            usuarios = resultado_usuario.get("data", [])
            if not usuarios:
                raise ValueError("No se encontró ese usuario de Roblox.")

            usuario = usuarios[0]
            id_usuario = usuario["id"]
            nombre_canonico = usuario.get("name", nombre_usuario)
            url_miniatura = (
                "https://thumbnails.roblox.com/v1/users/avatar-headshot"
                f"?userIds={id_usuario}&size=48x48&format=Png&isCircular=false"
            )
            with urllib.request.urlopen(url_miniatura, timeout=10) as respuesta:
                resultado_miniatura = json.loads(respuesta.read().decode("utf-8"))
            url_imagen = resultado_miniatura["data"][0]["imageUrl"]
            with urllib.request.urlopen(url_imagen, timeout=10) as respuesta:
                imagen = respuesta.read()
            root.after(0, lambda: mostrar_perfil_roblox(nombre_canonico, imagen))
        except Exception as error:
            root.after(0, lambda error=error: lbl_estado_perfil_roblox.config(
                text=f"No se pudo cargar el perfil: {error}", fg="#ffcc00"
            ))

    threading.Thread(target=worker, daemon=True).start()

