def mezclar_colores(color_primario, color_secundario, proporcion):
    componentes_primarios = tuple(int(color_primario[indice:indice + 2], 16) for indice in (1, 3, 5))
    componentes_secundarios = tuple(int(color_secundario[indice:indice + 2], 16) for indice in (1, 3, 5))
    componentes = tuple(
        round(primario * (1 - proporcion) + secundario * proporcion)
        for primario, secundario in zip(componentes_primarios, componentes_secundarios)
    )
    return "#" + "".join(f"{componente:02x}" for componente in componentes)

def aplicar_paleta_app(nueva_paleta):
    global app_theme_palette, app_accent_color

    paleta_anterior = app_theme_palette or APP_THEMES["GGSPQE"]
    colores_base = {
        "#121212": "bg", "#1e1e1e": "top", "#181818": "sidebar",
        "#222222": "panel", "#333333": "panel_alt", "#2d2d2d": "input",
        "#ffffff": "text", "#aaaaaa": "muted", "#00ffcc": "accent",
        "#a8cbb8": "accent_light", "#00cc88": "accent_light", "#00aa66": "accent_light",
        "#1f4037": "button", "#2f5f52": "button_active",
        "#552222": "danger", "#773333": "danger_active"
    }
    mapa_colores = {origen: nueva_paleta[rol] for origen, rol in colores_base.items()}
    mapa_colores.update({
        valor_anterior: nueva_paleta[rol]
        for rol, valor_anterior in paleta_anterior.items()
    })

    def recolorear(widget):
        for opcion in ("bg", "fg", "activebackground", "activeforeground", "selectcolor", "highlightbackground", "highlightcolor"):
            try:
                valor_actual = widget.cget(opcion).lower()
                if valor_actual in mapa_colores:
                    widget.configure(**{opcion: mapa_colores[valor_actual]})
            except (tk.TclError, AttributeError):
                pass
        for hijo in widget.winfo_children():
            recolorear(hijo)

    recolorear(root)
    estilo = ttk.Style(root)
    if "clam" in estilo.theme_names() and estilo.theme_use() != "clam":
        estilo.theme_use("clam")
    estilo.configure(
        "TCombobox",
        fieldbackground=nueva_paleta["input"],
        background=nueva_paleta["input"],
        foreground=nueva_paleta["text"],
        arrowcolor=nueva_paleta["accent"]
    )
    estilo.map(
        "TCombobox",
        fieldbackground=[("readonly", nueva_paleta["input"])],
        foreground=[("readonly", nueva_paleta["text"])],
        selectbackground=[("readonly", nueva_paleta["input"])],
        selectforeground=[("readonly", nueva_paleta["text"])]
    )
    app_theme_palette = dict(nueva_paleta)
    app_accent_color = nueva_paleta["accent"]
    if "lbl_muestra_color" in globals():
        lbl_muestra_color.config(bg=app_accent_color)
    if "combo_perfiles" in globals() and "lbl_muestra_color_perfil" in globals():
        actualizar_muestra_color_perfil()
    if "frame_superior_borde" in globals():
        frame_superior_borde.config(bg=app_accent_color)

