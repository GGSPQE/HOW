def aplicar_logica_lag():
    global lag_switch_activo
    stop_event = lag_switch_stop
    exito, error = aplicar_regla_firewall(activar=True)
    if not exito:
        lag_switch_activo = False
        root.after(0, lambda: mostrar_error_lag(error))
        return

    if stop_event.is_set() or not lag_switch_activo:
        aplicar_regla_firewall(activar=False)
        return
    
    try:
        milisegundos = float(entry_lag_duracion.get())
        if milisegundos > 0:
            if stop_event.wait(milisegundos / 1000.0):
                return
            lag_switch_activo = False
            root.after(0, actualizar_ui_lag_switch)
        else:
            stop_event.wait()
    except ValueError:
        pass

