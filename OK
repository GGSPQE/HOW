def ejecutar_shuffle_reload(e=None):
    global ejecutando_shuffle, shuffle_stop
    if ejecutando_shuffle or not esta_en_roblox():
        return

    try:
        delay = float(entry_shuffle_delay.get()) / 1000.0
        if delay < 0.03:
            delay = 0.03
    except ValueError:
        delay = 0.05

    active_slots = []
    if var_slot1.get(): active_slots.append("1")
    if var_slot2.get(): active_slots.append("2")
    if var_slot3.get(): active_slots.append("3")
    if var_slot4.get(): active_slots.append("4")
    beep = var_beep.get() and var_sonidos_app.get()
    shuffle_stop = threading.Event()
    stop_event = shuffle_stop
    ejecutando_shuffle = True

    def worker():
        global ejecutando_shuffle
        try:
            for key in active_slots:
                if stop_event.is_set():
                    break
                presionar_tecla_nativo(key)
                if stop_event.wait(delay):
                    break
                presionar_tecla_nativo("r")
                if stop_event.wait(delay):
                    break

            if beep:
                try:
                    ctypes.windll.kernel32.Beep(750, 40)
                except Exception:
                    pass
        finally:
            ejecutando_shuffle = False

    threading.Thread(target=worker, daemon=True).start()

def optimized_shoot(active_slots, delay, stop_event):
    user32 = ctypes.windll.user32
    for key in active_slots:
        if stop_event.is_set():
            return
        presionar_tecla_nativo(key)
        if stop_event.wait(delay):
            return
        user32.mouse_event(0x0002, 0, 0, 0, 0)
        user32.mouse_event(0x0004, 0, 0, 0, 0)
        if stop_event.wait(delay):
            return

def fast_gun_swap_worker(active_slots, delay, hold_mode, secondary_key, stop_event, generation):
    try:
        if hold_mode:
            while not stop_event.is_set() and keyboard.is_pressed(secondary_key):
                optimized_shoot(active_slots, delay, stop_event)
        else:
            while not stop_event.is_set():
                optimized_shoot(active_slots, delay, stop_event)
    finally:
        eventos_hotkey.put(("fast_swap_done", generation))

def auto_train_worker(active_slots, click_enabled, click_type, delay, stop_event, generation):
    user32 = ctypes.windll.user32
    click_flags = (0x0008, 0x0010) if click_type == "Clic Derecho" else (0x0002, 0x0004)
    try:
        while not stop_event.is_set():
            random.shuffle(active_slots)
            for key in active_slots:
                if stop_event.is_set():
                    break
                presionar_tecla_nativo(key)
                if stop_event.wait(delay):
                    break
                if click_enabled:
                    user32.mouse_event(click_flags[0], 0, 0, 0, 0)
                    try:
                        stop_event.wait(random.uniform(0.01, 0.03))
                    finally:
                        user32.mouse_event(click_flags[1], 0, 0, 0, 0)
                    if stop_event.is_set():
                        break
                    if stop_event.wait(delay):
                        break
    finally:
        eventos_hotkey.put(("auto_train_done", generation))

