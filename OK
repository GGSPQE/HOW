def agregar_evento_recorder(tipo, valor):
    if recorder_started_at is not None:
        recorder_events.append((time.perf_counter() - recorder_started_at, tipo, valor))

def grabar_tecla_recorder(evento):
    if evento.event_type not in (keyboard.KEY_DOWN, keyboard.KEY_UP) or not esta_en_roblox():
        return

    nombre_tecla = str(evento.name)
    with recorder_lock:
        if recorder_mode != "recording" or recorder_started_at is None:
            return
        if evento.event_type == keyboard.KEY_DOWN:
            if nombre_tecla in recorder_keys_down:
                return
            recorder_keys_down.add(nombre_tecla)
            agregar_evento_recorder("key_down", nombre_tecla)
        elif nombre_tecla in recorder_keys_down:
            recorder_keys_down.remove(nombre_tecla)
            agregar_evento_recorder("key_up", nombre_tecla)

def actualizar_estado_recorder(texto, color="#aaaaaa"):
    if avisos_recorder_activos:
        lbl_recorder_estado.config(text=texto, fg=color)

def programar_ui_recorder(texto, color="#aaaaaa", sonido=False):
    if avisos_recorder_activos:
        eventos_hotkey.put(("recorder_status", texto, color))
    if sonido and sonidos_activos:
        eventos_hotkey.put(("recorder_sound",))

def iniciar_grabacion_recorder():
    global recorder_events, recorder_mode, recorder_started_at
    global recorder_keyboard_hook, recorder_stop, recorder_keys_down, recorder_events_modo

    if recorder_mode != "idle" or (recorder_playback_stop and not recorder_playback_stop.is_set()):
        messagebox.showwarning("Recorder", "Detén la grabación o reproducción actual primero.")
        return

    with recorder_lock:
        recorder_events = []
        recorder_keys_down.clear()
        recorder_started_at = None
        recorder_mode = "waiting"
    recorder_events_modo = var_recorder_relativo.get()
    recorder_stop = threading.Event()
    registrar_log("Recorder", "Grabación iniciada" + (" (modo relativo)" if recorder_events_modo else ""))
    recorder_keyboard_hook = keyboard.hook(grabar_tecla_recorder, suppress=False)
    actualizar_lista_eventos_recorder()
    programar_ui_recorder("Pasa a Roblox para empezar a grabar...", "#ffcc00")
    threading.Thread(target=recorder_mouse_worker, daemon=True).start()

def recorder_mouse_worker():
    global recorder_mode, recorder_started_at, recorder_keyboard_hook

    user32 = ctypes.windll.user32
    botones_vinculados = {"izquierdo": 0x01, "derecho": 0x02, "central": 0x04}
    botones_pulsados = set()
    ultima_posicion = None
    punto = RECORDER_POINT()
    stop_event = recorder_stop
    countdown_restante = 0
    countdown_ultimo_tick = 0.0
    origen_ventana_grabacion = None

    while not stop_event.is_set():
        en_roblox = esta_en_roblox()
        with recorder_lock:
            if recorder_mode == "waiting" and en_roblox:
                recorder_mode = "countdown"
                countdown_restante = 3
                countdown_ultimo_tick = time.perf_counter()
                programar_ui_recorder("Empieza en 3...", "#ffcc00")
                eventos_hotkey.put(("recorder_countdown", 3, 3))
            elif recorder_mode == "countdown" and not en_roblox:
                recorder_mode = "waiting"
                programar_ui_recorder("Pasa a Roblox para empezar a grabar...", "#ffcc00")
                eventos_hotkey.put(("recorder_countdown", None, None))
            elif recorder_mode == "countdown" and en_roblox:
                ahora = time.perf_counter()
                if ahora - countdown_ultimo_tick >= 1.0:
                    countdown_restante -= 1
                    countdown_ultimo_tick = ahora
                    if countdown_restante > 0:
                        programar_ui_recorder(f"Empieza en {countdown_restante}...", "#ffcc00")
                        eventos_hotkey.put(("recorder_countdown", countdown_restante, 3))
                    else:
                        recorder_mode = "recording"
                        recorder_started_at = time.perf_counter()
                        origen_ventana_grabacion = obtener_rect_ventana_roblox() if recorder_events_modo else None
                        eventos_hotkey.put(("recorder_countdown", None, None))
                        programar_ui_recorder(
                            "Grabando... vuelve a esta ventana para terminar.", "#ff5555", sonido=True
                        )
            elif recorder_mode == "recording" and not en_roblox:
                break

            if recorder_mode == "recording":
                if user32.GetCursorPos(ctypes.byref(punto)):
                    if recorder_events_modo:
                        origen = origen_ventana_grabacion or obtener_rect_ventana_roblox()
                        posicion = (punto.x - origen[0], punto.y - origen[1]) if origen else (punto.x, punto.y)
                    else:
                        posicion = (punto.x, punto.y)
                    if posicion != ultima_posicion:
                        agregar_evento_recorder("mouse_move", posicion)
                        ultima_posicion = posicion

                for nombre_boton, codigo_boton in botones_vinculados.items():
                    pulsado = bool(user32.GetAsyncKeyState(codigo_boton) & 0x8000)
                    if pulsado and nombre_boton not in botones_pulsados:
                        botones_pulsados.add(nombre_boton)
                        agregar_evento_recorder("mouse_down", nombre_boton)
                    elif not pulsado and nombre_boton in botones_pulsados:
                        botones_pulsados.remove(nombre_boton)
                        agregar_evento_recorder("mouse_up", nombre_boton)
        stop_event.wait(0.01)

    with recorder_lock:
        if recorder_started_at is not None:
            for nombre_boton in botones_pulsados:
                agregar_evento_recorder("mouse_up", nombre_boton)
            for nombre_tecla in recorder_keys_down:
                agregar_evento_recorder("key_up", nombre_tecla)
            recorder_keys_down.clear()
        recorder_started_at = None
        recorder_mode = "idle"
        eventos_totales = len(recorder_events)

    if recorder_keyboard_hook is not None:
