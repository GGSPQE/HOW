# --- FUNCIONES NATIVAS DE WINDOWS Y SISTEMA ---

def obtener_ventana_activa():
    try:
        hwnd = ctypes.windll.user32.GetForegroundWindow()
        longitud = ctypes.windll.user32.GetWindowTextLengthW(hwnd)
        buffer = ctypes.create_unicode_buffer(longitud + 1)
        ctypes.windll.user32.GetWindowTextW(hwnd, buffer, longitud + 1)
        return buffer.value
    except Exception:
        return ""

def obtener_proceso_ventana_activa():
    """Nombre del ejecutable (ej: robloxplayerbeta.exe) de la ventana en primer plano."""
    try:
        user32 = ctypes.windll.user32
        kernel32 = ctypes.windll.kernel32
        hwnd = user32.GetForegroundWindow()
        pid = wintypes.DWORD()
        user32.GetWindowThreadProcessId(hwnd, ctypes.byref(pid))
        PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
        h_proceso = kernel32.OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, False, pid.value)
        if not h_proceso:
            return ""
        try:
            buffer = ctypes.create_unicode_buffer(260)
            tam = wintypes.DWORD(260)
            if kernel32.QueryFullProcessImageNameW(h_proceso, 0, buffer, ctypes.byref(tam)):
                return os.path.basename(buffer.value).lower()
        finally:
            kernel32.CloseHandle(h_proceso)
    except Exception:
        pass
    return ""

def esta_en_roblox():
    ventana_actual = obtener_ventana_activa().lower()
    if "ggspqe" in ventana_actual:
        return False
    if "roblox" in ventana_actual:
        return True
    # Respaldo: algunas ventanas de Roblox (multi-cuenta, localizadas) no tienen
    # "roblox" en el título, así que verificamos también el proceso propietario.
    return obtener_proceso_ventana_activa() in ("robloxplayerbeta.exe", "windowsuniversal.exe")

def obtener_rect_ventana_roblox():
    """Devuelve la esquina superior izquierda (x, y) de la ventana de Roblox en primer plano."""
    try:
        user32 = ctypes.windll.user32
        hwnd = user32.GetForegroundWindow()
        rect = wintypes.RECT()
        if user32.GetWindowRect(hwnd, ctypes.byref(rect)):
            return (rect.left, rect.top)
    except Exception:
        pass
    return None

def presionar_tecla_nativo(tecla_char):
    """Envía un par de eventos de teclado con scan codes explícitos."""
    user32 = ctypes.windll.user32
    char_key = str(tecla_char).lower()
    
    if char_key in VK_MAP:
        vk, scan_code = VK_MAP[char_key]
    else:
        vk = ord(char_key.upper())
        scan_code = user32.MapVirtualKeyW(vk, 0)

    eventos = (INPUT * 2)()
    eventos[0].type = 1
    eventos[0].ki = KEYBDINPUT(0, scan_code, 0x0008, 0, 0)
    eventos[1].type = 1
    eventos[1].ki = KEYBDINPUT(0, scan_code, 0x000A, 0, 0)

    user32.SendInput.argtypes = (wintypes.UINT, ctypes.POINTER(INPUT), ctypes.c_int)
    user32.SendInput.restype = wintypes.UINT
    enviados = user32.SendInput(2, eventos, ctypes.sizeof(INPUT))
    if enviados != 2:
        user32.keybd_event(vk, scan_code, 0, 0)
        time.sleep(0.015)
        user32.keybd_event(vk, scan_code, 0x0002, 0)

