def ajustar_botones_ventana(event=None):
    factor = min(1.5, max(1.0, root.winfo_width() / ancho_ventana))
    frame_izquierdo.config(width=round(160 * factor))
    for boton, ancho_base in botones_redimensionables:
        boton.config(width=round(ancho_base * factor))

def buscar_botones(widget):
    botones = []
    for hijo in widget.winfo_children():
        if isinstance(hijo, tk.Button):
            botones.append((hijo, int(hijo.cget("width"))))
        botones.extend(buscar_botones(hijo))
    return botones

botones_redimensionables = buscar_botones(root)
