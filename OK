NOMBRE_REGISTRO_INICIO = "GGSPQE"
CLAVE_REGISTRO_INICIO = r"Software\Microsoft\Windows\CurrentVersion\Run"

def esta_en_inicio_automatico():
    if winreg is None:
        return False
    try:
        with winreg.OpenKey(winreg.HKEY_CURRENT_USER, CLAVE_REGISTRO_INICIO, 0, winreg.KEY_READ) as clave:
            winreg.QueryValueEx(clave, NOMBRE_REGISTRO_INICIO)
            return True
    except OSError:
        return False

def establecer_inicio_automatico(activar):
    if winreg is None:
        return False
    try:
        with winreg.OpenKey(winreg.HKEY_CURRENT_USER, CLAVE_REGISTRO_INICIO, 0, winreg.KEY_SET_VALUE) as clave:
            if activar:
                if getattr(sys, "frozen", False):
                    comando = f'"{sys.executable}"'
                else:
                    comando = f'"{sys.executable}" "{os.path.abspath(sys.argv[0])}"'
                winreg.SetValueEx(clave, NOMBRE_REGISTRO_INICIO, 0, winreg.REG_SZ, comando)
            else:
                try:
                    winreg.DeleteValue(clave, NOMBRE_REGISTRO_INICIO)
                except FileNotFoundError:
                    pass
        return True
    except OSError as error:
        messagebox.showerror("Inicio automático", f"No se pudo modificar el inicio automático:\n{error}")
        return False

def alternar_inicio_automatico():
    if winreg is None:
        return
    exito = establecer_inicio_automatico(var_inicio_automatico.get())
    if exito:
        registrar_log("Sistema", "Inicio automático " + ("activado" if var_inicio_automatico.get() else "desactivado"))
    else:
        var_inicio_automatico.set(not var_inicio_automatico.get())



icono_bandeja = None

def crear_imagen_bandeja():
    tam = 64
    imagen = Image.new("RGB", (tam, tam), app_accent_color)
    dibujo = ImageDraw.Draw(imagen)
    dibujo.rectangle([3, 3, tam - 4, tam - 4], outline="#121212", width=4)
    try:
        fuente = ImageFont.truetype("arial.ttf", 30)
    except Exception:
        fuente = ImageFont.load_default()
    try:
        dibujo.text((tam / 2, tam / 2), "G", fill="#121212", anchor="mm", font=fuente)
    except TypeError:
        dibujo.text((tam / 2 - 8, tam / 2 - 12), "G", fill="#121212", font=fuente)
    return imagen

def _restaurar_ventana_bandeja():
    root.deiconify()
