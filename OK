def eliminar_texturas_roblox():
    def worker():
        dir_texturas = obtener_carpeta_texturas_roblox()
        if not dir_texturas:
            messagebox.showerror("Error", "No se encontró la carpeta de instalación de Roblox.")
            return
        
        try:
            dir_backup = dir_texturas + "_BACKUP"
            if not os.path.exists(dir_backup):
                shutil.copytree(dir_texturas, dir_backup)
            
            carpetas_objetivo = ["subsurface", "sky", "terrain"]
            for item in os.listdir(dir_texturas):
                ruta_item = os.path.join(dir_texturas, item)
                if os.path.isdir(ruta_item) and item.lower() in carpetas_objetivo:
                    for sub_root, sub_dirs, files in os.walk(ruta_item):
                        for f in files:
                            try:
                                os.remove(os.path.join(sub_root, f))
                            except Exception:
                                pass
            root.after(0, lambda: mostrar_banner("Texturas optimizadas para FPS Boost.", "exito"))
        except Exception as e:
            messagebox.showerror("Error", f"No se pudieron modificar las texturas: {e}")

    threading.Thread(target=worker, daemon=True).start()

def restaurar_texturas_roblox():
    def worker():
        dir_texturas = obtener_carpeta_texturas_roblox()
        if not dir_texturas:
            messagebox.showerror("Error", "No se encontró la instalación de Roblox.")
            return
        
        dir_backup = dir_texturas + "_BACKUP"
        if not os.path.exists(dir_backup):
            messagebox.showwarning("Advertencia", "No existe una copia de respaldo guardada para restaurar.")
            return

        try:
            shutil.rmtree(dir_texturas)
            shutil.copytree(dir_backup, dir_texturas)
            root.after(0, lambda: mostrar_banner("Texturas originales restauradas.", "exito"))
        except Exception as e:
            messagebox.showerror("Error", f"Fallo al restaurar texturas: {e}")

    threading.Thread(target=worker, daemon=True).start()

