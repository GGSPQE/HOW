def loop_anti_afk():
    global anti_afk_activo
    while anti_afk_activo:
        try:
            segundos_min = max(1.0, float(entry_afk_tiempo.get()))
        except ValueError:
            segundos_min = 60.0

        if var_afk_aleatorio.get():
            try:
                segundos_max = max(segundos_min, float(entry_afk_tiempo_max.get()))
            except ValueError:
                segundos_max = segundos_min + 30.0
            segundos_espera = random.uniform(segundos_min, segundos_max)
        else:
            segundos_espera = segundos_min

        objetivo = time.perf_counter() + segundos_espera
        ultimo_mostrado = None
        while anti_afk_activo:
            restante = objetivo - time.perf_counter()
            if restante <= 0:
                break
            restante_redondeado = round(restante)
            if restante_redondeado != ultimo_mostrado:
                ultimo_mostrado = restante_redondeado
                eventos_hotkey.put(("afk_countdown", restante_redondeado, segundos_espera))
            time.sleep(min(restante, 0.05))
        else:
            eventos_hotkey.put(("afk_countdown", None, None))
            return
        if not anti_afk_activo:
            eventos_hotkey.put(("afk_countdown", None, None))
            return
        eventos_hotkey.put(("afk_countdown", 0, segundos_espera))

        if anti_afk_activo and esta_en_roblox():
            if var_afk_pausa_activo.get():
                try:
                    umbral_seg = max(0.5, float(entry_afk_umbral_actividad.get()))
                except ValueError:
                    umbral_seg = 5.0
                if obtener_inactividad_ms() < umbral_seg * 1000:
                    registrar_historial_afk("Omitido (ya estás activo)")
                    continue
            ejecutar_accion_afk()

