def mostrar_banner(texto, tipo="info"):
    global _banner_after_id
    colores = {
        "info": ("#1f4037", "#00ffcc"),
        "exito": ("#1f4037", "#00ffcc"),
        "advertencia": ("#4a3a12", "#ffcc00"),
        "error": ("#552222", "#ff8080"),
    }
    bg, fg = colores.get(tipo, colores["info"])
    if _banner_after_id is not None:
        try:
            root.after_cancel(_banner_after_id)
        except tk.TclError:
            pass
    lbl_banner.config(text=texto, bg=bg, fg=fg)
    lbl_banner.pack(fill=tk.X, before=label_titulo_contenido)
    _banner_after_id = root.after(3500, ocultar_banner)

