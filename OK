def actualizar_estado_compacto():
    if not modo_compacto_activo:
        return
    estados = (("AFK", anti_afk_activo), ("Click", autoclicker_activo), ("Lag", lag_switch_activo))
    lbl_estado_compacto.config(text="   ".join(f"{n}: {'ON' if a else 'off'}" for n, a in estados))
    root.after(500, actualizar_estado_compacto)

def restaurar_modo_normal():
    global modo_compacto_activo
    if not modo_compacto_activo:
        return
    frame_compacto.pack_forget()
    frame_izquierdo.pack(side=tk.LEFT, fill=tk.Y)
    frame_principal.pack(side=tk.RIGHT, expand=True, fill=tk.BOTH)
    if tamano_ventana_normal:
        root.geometry(tamano_ventana_normal)
    modo_compacto_activo = False
    if "btn_modo_compacto" in globals():
        btn_modo_compacto.config(text="Modo compacto")

def activar_modo_compacto():
    global modo_compacto_activo, tamano_ventana_normal
    if modo_compacto_activo:
        return
    tamano_ventana_normal = root.geometry()
    frame_izquierdo.pack_forget()
    frame_principal.pack_forget()
    frame_compacto.pack(fill=tk.BOTH, expand=True)
    root.geometry("300x220")
    modo_compacto_activo = True
    if "btn_modo_compacto" in globals():
        btn_modo_compacto.config(text="Salir del modo compacto")
    actualizar_estado_compacto()

def alternar_modo_compacto():
    if modo_compacto_activo:
        restaurar_modo_normal()
    else:
        activar_modo_compacto()

tk.Button(
