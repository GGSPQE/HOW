def reproducir_recorder():
    global recorder_playback_stop

    with recorder_lock:
        eventos = list(recorder_events)
    if not eventos:
        messagebox.showwarning("Recorder", "Primero graba una secuencia en Roblox.")
        return
    if recorder_mode != "idle":
        messagebox.showwarning("Recorder", "Detén la grabación y espera a que termine antes de reproducir.")
        return
    if recorder_playback_stop is not None and not recorder_playback_stop.is_set():
        messagebox.showwarning("Recorder", "Ya hay una reproducción en curso.")
        return

    try:
        repeticiones = max(0, int(entry_recorder_repeticiones.get().strip()))
    except ValueError:
        repeticiones = 1
    try:
        velocidad = max(0.1, float(combo_recorder_velocidad.get().strip().lower().replace("x", "")))
    except ValueError:
        velocidad = 1.0

    recorder_playback_stop = threading.Event()
    estadisticas["macros_reproducidas"] += 1
    registrar_log(
        "Recorder",
        f"Reproducción iniciada ({len(eventos)} acciones, "
        f"{'∞' if repeticiones == 0 else repeticiones} vuelta(s), x{velocidad:g})"
    )
    programar_ui_recorder("Pasa a Roblox para reproducir la secuencia...", "#ffcc00")
    threading.Thread(
        target=reproducir_eventos_recorder,
        args=(eventos, recorder_playback_stop, repeticiones, velocidad, recorder_events_modo),
        daemon=True
    ).start()

def reproducir_eventos_recorder(eventos, stop_event, repeticiones=1, velocidad=1.0, modo_relativo=False):
    user32 = ctypes.windll.user32
    flags_mouse = {
        "izquierdo": (0x0002, 0x0004),
        "derecho": (0x0008, 0x0010),
        "central": (0x0020, 0x0040)
    }

    programar_ui_recorder("Reproduciendo...", "#00ffcc", sonido=True)
    while not stop_event.is_set() and not esta_en_roblox():
        if stop_event.wait(0.05):
            break

    try:
        if stop_event.is_set() or not esta_en_roblox():
            return

        origen_ventana = obtener_rect_ventana_roblox() if modo_relativo else None
        vuelta = 0
        while not stop_event.is_set() and (repeticiones == 0 or vuelta < repeticiones):
            vuelta += 1
            if repeticiones != 1:
                etiqueta_vueltas = f"{vuelta}" if repeticiones == 0 else f"{vuelta}/{repeticiones}"
                programar_ui_recorder(f"Reproduciendo (vuelta {etiqueta_vueltas})...", "#00ffcc")

            teclas_pulsadas = set()
            botones_pulsados = set()
            inicio = time.perf_counter()
            try:
                for instante, tipo, valor in eventos:
                    instante_escalado = instante / velocidad
                    while not stop_event.is_set():
                        if not esta_en_roblox():
                            stop_event.set()
                            break
                        restante = instante_escalado - (time.perf_counter() - inicio)
                        if restante <= 0:
                            break
                        stop_event.wait(min(restante, 0.02))
                    if stop_event.is_set():
                        break

                    if tipo == "key_down":
                        keyboard.press(valor)
                        teclas_pulsadas.add(valor)
                    elif tipo == "key_up":
                        keyboard.release(valor)
                        teclas_pulsadas.discard(valor)
                    elif tipo == "mouse_move":
                        if modo_relativo and origen_ventana:
                            user32.SetCursorPos(origen_ventana[0] + valor[0], origen_ventana[1] + valor[1])
                        else:
                            user32.SetCursorPos(*valor)
                    elif tipo == "mouse_down":
                        user32.mouse_event(flags_mouse[valor][0], 0, 0, 0, 0)
                        botones_pulsados.add(valor)
                    elif tipo == "mouse_up":
                        user32.mouse_event(flags_mouse[valor][1], 0, 0, 0, 0)
                        botones_pulsados.discard(valor)
            finally:
                for tecla in teclas_pulsadas:
                    keyboard.release(tecla)
                for boton in botones_pulsados:
                    user32.mouse_event(flags_mouse[boton][1], 0, 0, 0, 0)
    finally:
        reproduccion_interrumpida = stop_event.is_set()
        stop_event.set()
        mensaje = "Reproducción detenida." if reproduccion_interrumpida else "Reproducción terminada."
        programar_ui_recorder(mensaje, sonido=True)
        if not reproduccion_interrumpida:
            enviar_notificacion("Recorder", "Reproducción de macro terminada.")

def validar_eventos_recorder(eventos):
    if not isinstance(eventos, (list, tuple)):
        return []

    eventos_validados = []
    ultimo_instante = 0.0
    tipos_validos = {"key_down", "key_up", "mouse_move", "mouse_down", "mouse_up"}
    botones_validos = {"izquierdo", "derecho", "central"}
    for evento in eventos:
        if not isinstance(evento, (list, tuple)) or len(evento) != 3:
            return []
        instante, tipo, valor = evento
        if (
            isinstance(instante, bool)
            or not isinstance(instante, (int, float))
            or instante < ultimo_instante
            or not isinstance(tipo, str)
            or tipo not in tipos_validos
        ):
            return []
        if tipo in ("key_down", "key_up"):
            if not isinstance(valor, str) or not valor:
                return []
        elif tipo in ("mouse_down", "mouse_up"):
            if not isinstance(valor, str) or valor not in botones_validos:
                return []
        elif (
            not isinstance(valor, (list, tuple))
            or len(valor) != 2
            or any(isinstance(coordenada, bool) or not isinstance(coordenada, int) for coordenada in valor)
        ):
            return []
        ultimo_instante = float(instante)
        eventos_validados.append((ultimo_instante, tipo, tuple(valor) if tipo == "mouse_move" else valor))
    return eventos_validados

