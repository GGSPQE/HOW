def registrar_hotkey(tecla, accion):
    partes = [parte.strip().lower() for parte in tecla.split("+") if parte.strip()]
    if not partes:
        return None

    codigos = [set(keyboard.key_to_scan_codes(parte)) for parte in partes]
    if any(not codigos_parte for codigos_parte in codigos):
        raise ValueError(f"Tecla no reconocida en el atajo: {tecla}")

    if len(partes) == 1:
        return keyboard.hook_key(
            partes[0],
            lambda evento: encolar_hotkey_si_nueva(accion, evento),
            suppress=False
        )

    codigos_disparador = codigos[-1]
    codigos_modificadores = codigos[:-1]
    presionadas = set()
    disparado = False

    def detectar_combinacion(evento):
        nonlocal disparado
        if evento.event_type == keyboard.KEY_DOWN:
            presionadas.add(evento.scan_code)
            if (
                evento.scan_code in codigos_disparador
                and not disparado
                and not ignorar_hotkey_durante_reproduccion(accion)
                and all(presionadas.intersection(codigos_parte) for codigos_parte in codigos_modificadores)
            ):
                disparado = True
                eventos_hotkey.put(accion)
        else:
            presionadas.discard(evento.scan_code)
            if evento.scan_code in codigos_disparador:
                disparado = False

    return keyboard.hook(detectar_combinacion, suppress=False)

def procesar_eventos_hotkey():
    global fast_gun_swap_activo, fast_gun_swap_stop, auto_train_activo, auto_train_stop
    while not eventos_hotkey.empty():
        evento = eventos_hotkey.get()
        if isinstance(evento, tuple) and evento[0] == "fast_swap_done":
            if evento[1] == fast_gun_swap_generation:
                fast_gun_swap_activo = False
                fast_gun_swap_stop = None
                lbl_fast_gun_swap.config(text="Fast Gun Swap: detenido", fg="#aaaaaa")
        elif isinstance(evento, tuple) and evento[0] == "auto_train_done":
            if evento[1] == auto_train_generation:
                auto_train_activo = False
                auto_train_stop = None
                btn_auto_train.config(text="Iniciar Auto Train", bg="#2d2d2d")
                lbl_auto_train_estado.config(text="Auto Train: detenido", fg="#aaaaaa")
        elif isinstance(evento, tuple) and evento[0] == "recorder_status":
            actualizar_estado_recorder(evento[1], evento[2])
        elif isinstance(evento, tuple) and evento[0] == "recorder_sound":
            root.bell()
        elif isinstance(evento, tuple) and evento[0] == "recorder_countdown":
            restante, total = evento[1], evento[2]
            if restante is None or not total:
                barra_recorder_countdown["value"] = 0
            else:
                barra_recorder_countdown["value"] = max(0, min(100, (total - restante) / total * 100))
        elif isinstance(evento, tuple) and evento[0] == "recorder_events_ready":
            actualizar_lista_eventos_recorder()
        elif isinstance(evento, tuple) and evento[0] == "afk_countdown":
            segundos, total = evento[1], evento[2]
            if segundos is None:
                lbl_afk_countdown.config(text="Próxima acción: --")
                barra_afk_countdown["value"] = 0
            elif segundos <= 0:
                lbl_afk_countdown.config(text="Próxima acción: ahora")
                barra_afk_countdown["value"] = 100
            else:
                lbl_afk_countdown.config(text=f"Próxima acción en: {segundos}s")
                if total:
                    barra_afk_countdown["value"] = max(0, min(100, (total - segundos) / total * 100))
        elif isinstance(evento, tuple) and evento[0] == "afk_historial_actualizado":
            actualizar_lista_historial_afk()
        elif isinstance(evento, tuple) and evento[0] == "log_actualizado":
            actualizar_lista_log_global()
        elif isinstance(evento, tuple) and evento[0] == "hotkey_capture_done":
            finalizar_captura_hotkey(evento[1])
        elif isinstance(evento, tuple) and evento[0] == "hotkey_capture_cancel":
            cancelar_captura_hotkey()
        elif evento == "afk":
            toggle_anti_afk()
        elif evento == "click":
            toggle_autoclicker()
        elif evento == "lag":
            toggle_lag_switch()
        elif evento == "shuffle":
            ejecutar_shuffle_reload()
        elif evento == "fast_swap":
            toggle_fast_gun_swap()
        elif evento == "auto_train":
            toggle_auto_train()
        elif evento == "recorder_start":
            iniciar_grabacion_recorder()
        elif evento == "recorder_play":
            reproducir_recorder()
        elif evento == "recorder_stop":
            detener_recorder()
    root.after(20, procesar_eventos_hotkey)

def actualizar_ui_lag_switch():
    if lag_switch_activo:
        btn_lagswitch.config(text="Desactivar Lag Switch", bg="#552222")
