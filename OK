# --- EFECTOS VISUALES MODERNOS (hover, foco, cursores) ---

def _mezclar_rgb(base, mezcla, cantidad):
    return tuple(min(255, max(0, round(b + (m - b) * cantidad))) for b, m in zip(base, mezcla))

def aplicar_efecto_hover(boton):
    """Aclara el fondo del botón al pasar el mouse por encima (efecto hover moderno)."""
    def al_entrar(event):
        try:
            r, g, b = boton.winfo_rgb(boton.cget("bg"))
            base = (r // 256, g // 256, b // 256)
            claro = _mezclar_rgb(base, (255, 255, 255), 0.18)
            boton._color_original_hover = boton.cget("bg")
            boton.config(bg="#%02x%02x%02x" % claro)
        except tk.TclError:
            pass

    def al_salir(event):
        color_previo = getattr(boton, "_color_original_hover", None)
        if color_previo:
            try:
                boton.config(bg=color_previo)
            except tk.TclError:
                pass

    boton.config(cursor="hand2")
    boton.bind("<Enter>", al_entrar, add="+")
    boton.bind("<Leave>", al_salir, add="+")

def modernizar_widgets(widget):
    """Recorre todo el árbol de widgets aplicando hover, foco y cursores modernos."""
    for hijo in widget.winfo_children():
        try:
            if isinstance(hijo, tk.Button):
                aplicar_efecto_hover(hijo)
            elif isinstance(hijo, tk.Entry):
                hijo.config(highlightthickness=1, highlightbackground="#333333", highlightcolor="#00ffcc")

                def _foco_dentro(event, w=hijo):
                    try:
                        w.config(highlightbackground=app_accent_color)
                    except tk.TclError:
                        pass

                def _foco_fuera(event, w=hijo):
                    try:
                        w.config(highlightbackground="#333333")
                    except tk.TclError:
                        pass

                hijo.bind("<FocusIn>", _foco_dentro, add="+")
                hijo.bind("<FocusOut>", _foco_fuera, add="+")
            elif isinstance(hijo, tk.Checkbutton):
                hijo.config(cursor="hand2")
        except tk.TclError:
            pass
        modernizar_widgets(hijo)

def crear_seccion_acordeon(parent, fila, titulo, expandido=True):
    """Crea una sección con cabecera clicable que expande/colapsa su contenido."""
    contenedor = tk.Frame(parent, bg="#121212")
    contenedor.grid(row=fila, column=0, columnspan=3, pady=(0, 6), sticky="ew")

    estado = {"expandido": expandido}
    cabecera = tk.Frame(contenedor, bg="#181818", cursor="hand2")
    cabecera.pack(fill=tk.X)
    lbl_flecha = tk.Label(cabecera, text="▼" if expandido else "▶", bg="#181818", fg="#00ffcc", font=("Segoe UI", 9, "bold"))
    lbl_flecha.pack(side=tk.LEFT, padx=(8, 4), pady=4)
    tk.Label(cabecera, text=titulo, bg="#181818", fg="#00ffcc", font=("Segoe UI", 9, "bold")).pack(side=tk.LEFT, pady=4)

    cuerpo = tk.Frame(contenedor, bg="#121212")
    if expandido:
        cuerpo.pack(fill=tk.X, pady=(6, 0))

    def alternar(event=None):
        if estado["expandido"]:
            cuerpo.pack_forget()
            lbl_flecha.config(text="▶")
        else:
            cuerpo.pack(fill=tk.X, pady=(6, 0))
            lbl_flecha.config(text="▼")
        estado["expandido"] = not estado["expandido"]

    cabecera.bind("<Button-1>", alternar)
    for hijo in cabecera.winfo_children():
        hijo.bind("<Button-1>", alternar)

    return cuerpo

def agregar_tooltip(widget, texto):
    """Muestra un pequeño globo de ayuda al pasar el mouse sobre un control."""
    estado = {"ventana": None, "id_espera": None}

    def mostrar():
        estado["id_espera"] = None
        if estado["ventana"] is not None or not widget.winfo_exists():
            return
        x = widget.winfo_rootx() + 10
        y = widget.winfo_rooty() + widget.winfo_height() + 4
        ventana = tk.Toplevel(widget)
        ventana.overrideredirect(True)
        try:
            ventana.attributes("-topmost", True)
        except tk.TclError:
            pass
        ventana.geometry(f"+{x}+{y}")
        tk.Label(
            ventana, text=texto, bg="#222222", fg="white", font=("Segoe UI", 8),
            bd=1, relief="solid", padx=6, pady=3, wraplength=220, justify=tk.LEFT
        ).pack()
        estado["ventana"] = ventana

    def al_entrar(event=None):
        estado["id_espera"] = widget.after(450, mostrar)

    def ocultar(event=None):
        if estado["id_espera"] is not None:
            try:
                widget.after_cancel(estado["id_espera"])
            except tk.TclError:
                pass
            estado["id_espera"] = None
        if estado["ventana"] is not None:
            try:
                estado["ventana"].destroy()
            except tk.TclError:
                pass
            estado["ventana"] = None

    widget.bind("<Enter>", al_entrar, add="+")
    widget.bind("<Leave>", ocultar, add="+")
    widget.bind("<ButtonPress>", ocultar, add="+")

