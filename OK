    global icono_bandeja
    if pystray is None:
        return
    root.withdraw()
    if icono_bandeja is None:
        menu = pystray.Menu(
            pystray.MenuItem("Mostrar GGSPQE", restaurar_desde_bandeja, default=True),
            pystray.MenuItem("Detener todo", lambda icon, item: root.after(0, detener_todo)),
            pystray.MenuItem("Salir", salir_desde_bandeja)
        )
        icono_bandeja = pystray.Icon("ggspqe", crear_imagen_bandeja(), "GGSPQE - Roblox Utility Pro", menu)
