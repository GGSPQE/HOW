def elegir_textura_destino(dir_categoria, dir_backup, extension, nombre_origen):
    candidatos = {}
    for raiz in (dir_categoria, dir_backup):
        if not os.path.isdir(raiz):
            continue
        for carpeta_actual, subcarpetas, nombres in os.walk(raiz, followlinks=False):
            subcarpetas[:] = [
                nombre for nombre in subcarpetas
                if not os.path.islink(os.path.join(carpeta_actual, nombre))
            ]
            for nombre in nombres:
                ruta = os.path.join(carpeta_actual, nombre)
                if os.path.islink(ruta) or os.path.splitext(nombre)[1].lower() != extension:
                    continue
                relativa = os.path.relpath(ruta, raiz)
                candidatos.setdefault(os.path.normcase(relativa), relativa)

    opciones = sorted(candidatos.values(), key=str.casefold)
    if not opciones:
        return None

    dialogo = tk.Toplevel(root)
    dialogo.title("Elegir textura a reemplazar")
    dialogo.transient(root)
    dialogo.grab_set()
    tk.Label(
        dialogo,
        text=f"No hay coincidencia para {nombre_origen}. Selecciona el destino:"
    ).pack(anchor="w", padx=10, pady=(10, 4))

    marco_lista = tk.Frame(dialogo)
    marco_lista.pack(fill=tk.BOTH, expand=True, padx=10, pady=4)
    lista = tk.Listbox(marco_lista, width=58, height=min(18, max(6, len(opciones))), exportselection=False)
    barra = tk.Scrollbar(marco_lista, orient=tk.VERTICAL, command=lista.yview)
    lista.configure(yscrollcommand=barra.set)
    lista.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
    barra.pack(side=tk.RIGHT, fill=tk.Y)
    for opcion in opciones:
        lista.insert(tk.END, opcion)
    lista.selection_set(0)

    seleccion = {"ruta": None}

    def confirmar(event=None):
        indices = lista.curselection()
        if indices:
            seleccion["ruta"] = opciones[indices[0]]
            dialogo.destroy()

    def cancelar():
        dialogo.destroy()

    marco_botones = tk.Frame(dialogo)
    marco_botones.pack(fill=tk.X, padx=10, pady=(4, 10))
    tk.Button(marco_botones, text="Cancelar", command=cancelar).pack(side=tk.RIGHT, padx=(4, 0))
    tk.Button(marco_botones, text="Reemplazar", command=confirmar).pack(side=tk.RIGHT)
    lista.bind("<Double-Button-1>", confirmar)
    dialogo.bind("<Return>", confirmar)
    dialogo.bind("<Escape>", lambda event: cancelar())
    dialogo.protocol("WM_DELETE_WINDOW", cancelar)
    lista.focus_set()
    root.wait_window(dialogo)
    return seleccion["ruta"]

def reiniciar_roblox(exe_roblox):
    try:
        resultado = subprocess.run(
            ["taskkill", "/F", "/IM", os.path.basename(exe_roblox)],
            capture_output=True,
            text=True,
            timeout=15
        )
        if resultado.returncode != 0:
            detalle = resultado.stderr.strip() or resultado.stdout.strip()
            raise OSError(detalle or "No se pudo cerrar Roblox.")
        if not webbrowser.open("https://www.roblox.com/home", new=2):
            raise OSError("No se pudo abrir la página oficial de Roblox.")
    except Exception as error:
        root.after(0, lambda error=error: messagebox.showerror(
            "No se pudo reiniciar Roblox",
            f"Las texturas se instalaron, pero no se pudo abrir Roblox.com. Abre Roblox manualmente.\n{error}"
        ))

def ofrecer_reinicio_roblox(exe_roblox, categoria, cantidad):
    nombre_ejecutable = os.path.basename(exe_roblox)
    try:
        procesos = subprocess.run(
            ["tasklist", "/FI", f"IMAGENAME eq {nombre_ejecutable}", "/FO", "CSV", "/NH"],
            capture_output=True,
            text=True,
            timeout=5
        )
        roblox_abierto = nombre_ejecutable.lower() in procesos.stdout.lower()
    except (OSError, subprocess.SubprocessError):
        roblox_abierto = False

    if not roblox_abierto:
        messagebox.showinfo(
            "Texturas instaladas",
            f"Se instalaron {cantidad} archivos de {categoria}. Abre Roblox para aplicar los cambios."
        )
        return

    if messagebox.askyesno(
        "Reiniciar Roblox",
        f"Se instalaron {cantidad} archivos de {categoria}. Roblox se cerrará y se abrirá Roblox.com. "
        "Pulsa Jugar en la página para iniciar con una autenticación nueva. ¿Continuar?"
    ):
        threading.Thread(target=reiniciar_roblox, args=(exe_roblox,), daemon=True).start()

def instalar_paquete_texturas(carpeta_paquete=None, archivos_sueltos=None):
    categoria = combo_categoria_textura.get().strip()
    if categoria not in TEXTURE_CATEGORIES:
        messagebox.showwarning("Texturas", "Selecciona una categoría.")
        return

    if carpeta_paquete is None and archivos_sueltos is None:
        carpeta_paquete = filedialog.askdirectory(
            parent=root,
            title=f"Seleccionar texturas personalizadas: {categoria}"
        )
        if not carpeta_paquete:
            return

    exe_roblox = obtener_ruta_roblox()
    if not exe_roblox:
        messagebox.showerror("Error", "No se encontró la instalación de Roblox.")
        return

    directorio_version = os.path.dirname(exe_roblox)
    ruta_relativa_categoria, extensiones_textura = TEXTURE_CATEGORIES[categoria]
    dir_categoria = os.path.join(directorio_version, ruta_relativa_categoria)
    dir_backup = dir_categoria + "_BACKUP"
    raiz_texturas = os.path.normcase(os.path.realpath(dir_categoria))
    raiz_backup = os.path.normcase(os.path.realpath(dir_backup))
    raiz_instalacion = os.path.normcase(os.path.realpath(directorio_version))
    archivos_paquete = []
    reemplazos = []
    if archivos_sueltos is None:
        raiz_paquete = os.path.normcase(os.path.realpath(carpeta_paquete))
        try:
            raiz_compartida = os.path.commonpath((raiz_paquete, raiz_instalacion))
        except ValueError:
            raiz_compartida = ""
        if raiz_compartida in (raiz_paquete, raiz_instalacion):
            messagebox.showerror("Carpeta no válida", "El paquete debe estar fuera de la carpeta de Roblox.")
            return

        for carpeta_actual, subcarpetas, nombres in os.walk(raiz_paquete, followlinks=False):
            subcarpetas[:] = [
                nombre for nombre in subcarpetas
                if not os.path.islink(os.path.join(carpeta_actual, nombre))
            ]
            for nombre_archivo in nombres:
                origen = os.path.join(carpeta_actual, nombre_archivo)
                if os.path.islink(origen):
                    continue
                archivos_paquete.append((origen, os.path.relpath(origen, raiz_paquete)))
    else:
        for origen in archivos_sueltos:
            origen = os.path.normpath(origen)
            if os.path.isdir(origen):
                for carpeta_actual, subcarpetas, nombres in os.walk(origen, followlinks=False):
                    subcarpetas[:] = [
                        nombre for nombre in subcarpetas
                        if not os.path.islink(os.path.join(carpeta_actual, nombre))
                    ]
                    for nombre_archivo in nombres:
                        ruta_origen = os.path.join(carpeta_actual, nombre_archivo)
                        if not os.path.islink(ruta_origen):
                            archivos_paquete.append((ruta_origen, os.path.relpath(ruta_origen, origen)))
            elif os.path.isfile(origen) and not os.path.islink(origen):
                archivos_paquete.append((origen, os.path.basename(origen)))

    for origen, ruta_relativa in archivos_paquete:
        if os.path.splitext(origen)[1].lower() not in extensiones_textura:
            continue
        try:
            raiz_origen = os.path.normcase(os.path.realpath(origen))
            if os.path.commonpath((raiz_origen, raiz_instalacion)) == raiz_instalacion:
                continue
        except ValueError:
            pass
        destino = os.path.join(raiz_texturas, ruta_relativa)
        original = os.path.join(raiz_backup, ruta_relativa)
        existe_en_instalacion = os.path.isfile(destino) and not os.path.islink(destino)
        existe_en_respaldo = os.path.isfile(original) and not os.path.islink(original)
        if not existe_en_instalacion and not existe_en_respaldo:
            if archivos_sueltos is None:
                continue
            ruta_destino = elegir_textura_destino(
                dir_categoria,
                dir_backup,
                os.path.splitext(origen)[1].lower(),
                os.path.basename(origen)
            )
            if ruta_destino is None:
                continue
            destino = os.path.join(raiz_texturas, ruta_destino)
        if os.path.commonpath((raiz_texturas, os.path.normcase(os.path.realpath(destino)))) != raiz_texturas:
            continue
        reemplazos.append((origen, destino))

    if not reemplazos:
        messagebox.showwarning(
            "Sin coincidencias",
            "No se encontraron archivos de textura con la misma ruta y nombre en Roblox."
        )
        return

    if not messagebox.askyesno(
        "Confirmar instalación",
        f"Categoría: {categoria}\nSe reemplazarán {len(reemplazos)} archivos coincidentes.\n"
        f"Se conservará una copia original en:\n{dir_backup}\n\n¿Continuar?"
    ):
        return

    def worker():
        try:
            if os.path.exists(dir_backup) and not os.path.isdir(dir_backup):
                raise OSError("La ruta de respaldo existe, pero no es una carpeta.")
            if not os.path.exists(dir_backup):
                if not os.path.isdir(dir_categoria):
                    raise OSError("La carpeta original de esta categoría no existe para crear el respaldo.")
                shutil.copytree(dir_categoria, dir_backup)

            for origen, destino in reemplazos:
                os.makedirs(os.path.dirname(destino), exist_ok=True)
                shutil.copy2(origen, destino)

            root.after(0, lambda: ofrecer_reinicio_roblox(
                exe_roblox, categoria, len(reemplazos)
            ))
        except Exception as error:
            root.after(0, lambda error=error: messagebox.showerror(
                "Error al instalar texturas",
                f"No se pudo completar la instalación. Si hubo cambios parciales, restaura esta categoría.\n{error}"
            ))

    threading.Thread(target=worker, daemon=True).start()

def restaurar_categoria_texturas():
    categoria = combo_categoria_textura.get().strip()
    if categoria not in TEXTURE_CATEGORIES:
        messagebox.showwarning("Texturas", "Selecciona una categoría.")
        return

    exe_roblox = obtener_ruta_roblox()
    if not exe_roblox:
        messagebox.showerror("Error", "No se encontró la instalación de Roblox.")
        return

    ruta_relativa_categoria, _ = TEXTURE_CATEGORIES[categoria]
    dir_categoria = os.path.join(os.path.dirname(exe_roblox), ruta_relativa_categoria)
    dir_backup = dir_categoria + "_BACKUP"
    if not os.path.isdir(dir_backup):
        messagebox.showwarning("Respaldo no encontrado", f"No hay respaldo propio para {categoria}.")
        return

    if not messagebox.askyesno("Restaurar categoría", f"¿Restaurar las texturas originales de {categoria}?"):
        return

    def worker():
        try:
            if os.path.exists(dir_categoria):
                shutil.rmtree(dir_categoria)
            shutil.copytree(dir_backup, dir_categoria)
            root.after(0, lambda: mostrar_banner(f"Se restauró la categoría: {categoria}.", "exito"))
        except Exception as error:
            root.after(0, lambda error=error: messagebox.showerror("Error al restaurar", str(error)))

    threading.Thread(target=worker, daemon=True).start()

def eliminar_agua_roblox():
