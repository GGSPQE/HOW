def normalizar_nombre_tecla(nombre):
    nombre = nombre.lower().replace("left ", "").replace("right ", "")
    return {"windows": "windows", "command": "windows"}.get(nombre, nombre)

def recibir_tecla_para_captura(evento):
    global captura_hotkey_activa, captura_modificador_suelto
    nombre = normalizar_nombre_tecla(evento.name)
    modificadores = {"ctrl", "shift", "alt", "windows"}

    if evento.event_type == keyboard.KEY_DOWN:
        if evento.scan_code in captura_teclas_pulsadas:
            return
        captura_teclas_pulsadas.add(evento.scan_code)
        if nombre == "esc":
            eventos_hotkey.put(("hotkey_capture_cancel",))
        elif nombre in modificadores:
            captura_modificadores.add(nombre)
            captura_modificador_suelto = nombre
        else:
            combo = "+".join(sorted(captura_modificadores) + [nombre])
            eventos_hotkey.put(("hotkey_capture_done", combo))
    else:
        captura_teclas_pulsadas.discard(evento.scan_code)
        if nombre in modificadores:
            captura_modificadores.discard(nombre)
            if captura_modificador_suelto == nombre and not captura_teclas_pulsadas:
                eventos_hotkey.put(("hotkey_capture_done", nombre))
            captura_modificador_suelto = None

