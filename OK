def identidad_hotkey(tecla):
    partes = [parte.strip().lower() for parte in tecla.split("+") if parte.strip()]
    if not partes:
        return None
    codigos = [frozenset(keyboard.key_to_scan_codes(parte)) for parte in partes]
    if any(not codigos_parte for codigos_parte in codigos):
        raise ValueError(f"Tecla no reconocida en el atajo: {tecla}")
    return frozenset(codigos)

def encontrar_conflictos_hotkeys(atajos):
    propietarios = {}
    for nombre, tecla in atajos:
        if not tecla:
            continue
        identidad = identidad_hotkey(tecla)
        propietarios.setdefault(identidad, []).append(nombre)
    return [nombres for nombres in propietarios.values() if len(nombres) > 1]

