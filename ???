-- Tu toggle personalizado
local Toggle = Tab:CreateToggle({
	Name = "(718) Jump Power",
	CurrentValue = false,
	Flag = "Jump Power",
	Callback = function(Value)
		jumpPowerOn = Value

		if player.Character then
			humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				if jumpPowerOn then
					humanoid.UseJumpPower = true
					humanoid.JumpPower = 100 -- Puedes cambiar este valor
				else
					humanoid.JumpPower = 50 -- Valor normal por defecto
				end
			end
		end
	end,
})

-- Si el jugador respawnea, aplicar el jump power de nuevo si está activado
player.CharacterAdded:Connect(function(char)
	char:WaitForChild("Humanoid")
	humanoid = char:FindFirstChildOfClass("Humanoid")
	if jumpPowerOn and humanoid then
		humanoid.UseJumpPower = true
		humanoid.JumpPower = 100
	elseif humanoid then
		humanoid.JumpPower = 50
	end
end)

